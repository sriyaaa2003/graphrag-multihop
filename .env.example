# Deployment settings (prefix GH_).
GH_DB_PATH=graphhop.db
GH_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Protects ingestion and deletion. Unset = those endpoints are disabled (503).
GH_ADMIN_API_KEY=
GH_CHUNK_CHARS=800
GH_CHUNK_OVERLAP_CHARS=100
GH_TITLE_AS_ENTITY=true
# proper_noun (default, no model needed) or llm (typed triples; needs the LLM settings below)
GH_EXTRACTOR=proper_noun
# Retrieval defaults (overridable per request)
GH_DEFAULT_K=5
GH_PPR_ALPHA=0.85
GH_MAX_HOPS=3
GH_SEED_FROM_DENSE_TOP_N=1
GH_DENSE_SEED_WEIGHT=0.5
GH_W_DENSE=1.0
GH_W_GRAPH=1.0
# Optional generation / LLM extraction. Retrieval works without it.
# GH_LLM_PROVIDER=anthropic          # or openai_compat
# GH_LLM_MODEL_ID=
# GH_LLM_BASE_URL=                   # e.g. http://localhost:11434/v1 for openai_compat servers
# GH_LLM_API_KEY_ENV=ANTHROPIC_API_KEY   # NAME of the variable that holds the key
# Graph channel: "expand" (graph proposes candidates, dense similarity ranks them) or "ppr" (PageRank)
GH_GRAPH_STRATEGY=expand
GH_EXPAND_HOPS=1
GH_TITLE_ONLY=true
